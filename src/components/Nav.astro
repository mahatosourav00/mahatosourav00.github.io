---
import { site } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav" transition:persist="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="Home">
      <span class="nav__mark">{site.short}</span><span class="accent">.</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {site.nav.map((item, i) => (
        <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} data-nav-link>
          <span class="nav__idx">0{i + 1}</span>{item.label}
        </a>
      ))}
    </nav>

    <div class="nav__right">
      <button class="nav__theme" data-theme-toggle aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4"/>
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
        </svg>
      </button>
      <button class="nav__burger" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      {site.nav.map((item, i) => (
        <a href={item.href} class="menu__link" data-nav-link>
          <span class="mono muted">0{i + 1}</span>{item.label}
        </a>
      ))}
      <a href="/cv" class="menu__link" data-nav-link><span class="mono muted">CV</span>Résumé</a>
    </nav>
    <p class="mono muted">{site.email}</p>
  </div>
</header>

<script>
  function setupNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const nav = document.querySelector<HTMLElement>('.nav');
    const path = location.pathname.replace(/\/$/, '') || '/';

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
      const href = a.getAttribute('href') || '';
      a.classList.toggle('is-active', path === href || path.startsWith(href + '/'));
    });

    if (toggle && !toggle.dataset.bound) {
      toggle.dataset.bound = '1';
      toggle.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });
    }

    if (burger && menu && !burger.dataset.bound) {
      burger.dataset.bound = '1';
      const close = () => {
        burger.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        document.body.style.overflow = '';
      };
      burger.addEventListener('click', () => {
        const open = burger.getAttribute('aria-expanded') !== 'true';
        burger.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        if (open) nav?.classList.remove('is-hidden');
        document.body.style.overflow = open ? 'hidden' : '';
      });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      document.addEventListener('astro:before-swap', close);
    }

    if (nav && !nav.dataset.bound) {
      nav.dataset.bound = '1';
      let last = window.scrollY;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        const menuOpen = burger?.getAttribute('aria-expanded') === 'true';
        nav.classList.toggle('is-hidden', y > last && y > 160 && !menuOpen);
        nav.classList.toggle('is-scrolled', y > 20);
        last = y;
      }, { passive: true });
    }
    nav?.classList.remove('is-hidden');
  }
  document.addEventListener('astro:page-load', setupNav);
</script>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: transform 0.6s var(--ease); }
  .nav.is-hidden { transform: translateY(-100%); }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    max-width: var(--max); margin-inline: auto; padding: 22px var(--gutter);
  }
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line); transition: opacity 0.4s var(--ease);
  }
  .nav.is-scrolled::before { opacity: 1; }
  .nav__logo { font-family: var(--font-display); font-size: 30px; line-height: 1; }
  .nav__links { display: flex; gap: 28px; }
  .nav__link { position: relative; font-size: 14px; color: var(--muted); transition: color 0.3s; display: flex; gap: 6px; align-items: baseline; }
  .nav__link:hover, .nav__link.is-active { color: var(--text); }
  .nav__idx { font-family: var(--font-mono); font-size: 10px; color: var(--faint); }
  .nav__link.is-active .nav__idx { color: var(--accent); }
  .nav__right { display: flex; align-items: center; gap: 14px; }
  .nav__theme { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); transition: transform 0.6s var(--ease); }
  .nav__theme:hover { transform: rotate(180deg); }
  .nav__burger { display: none; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); position: relative; }
  .nav__burger span { position: absolute; left: 12px; right: 12px; height: 1.4px; background: currentColor; transition: transform 0.4s var(--ease); }
  .nav__burger span:first-child { top: 16px; }
  .nav__burger span:last-child { top: 22px; }
  .nav__burger[aria-expanded='true'] span:first-child { transform: translateY(3px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] span:last-child { transform: translateY(-3px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: -1; background: var(--bg); height: 100dvh;
    padding: 110px var(--gutter) 32px; display: flex; flex-direction: column; justify-content: space-between;
  }
  .menu[hidden] { display: none; }
  .menu nav { display: flex; flex-direction: column; }
  .menu__link {
    display: flex; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line);
    font-family: var(--font-display); font-size: clamp(36px, 10vw, 56px); line-height: 1.05;
  }
  .menu__link.is-active { color: var(--accent); }

  @media (max-width: 960px) {
    .nav__links { display: none; }
    .nav__burger { display: block; }
  }
</style>
