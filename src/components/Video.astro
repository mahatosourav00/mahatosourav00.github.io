---
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // path under /public, e.g. /videos/fpv/ajodhya.mp4
  poster?: ImageMetadata;
  alt: string;
  ratio?: string;
  // 'view'  : plays while on screen, with controls (big hobby-album clips)
  // 'hover' : poster until hovered / tapped, no controls (small gallery tiles)
  mode?: 'view' | 'hover';
}
const { src, poster, alt, ratio, mode = 'view' } = Astro.props;
const r = ratio ?? (poster ? `${poster.width} / ${poster.height}` : '16 / 9');
const hover = mode === 'hover';
---
<div class:list={['vid', { 'vid--hover': hover }]} style={`aspect-ratio:${r}`}>
  <video
    src={src}
    poster={poster?.src}
    muted
    loop
    playsinline
    controls={!hover}
    preload={hover ? 'metadata' : 'none'}
    aria-label={alt}
    data-autoplay={hover ? undefined : ''}
    data-hover-play={hover ? '' : undefined}
  ></video>
  {hover && <span class="vid__badge" aria-hidden="true">▶ <span>play</span></span>}
</div>

<style>
  .vid { position: relative; overflow: hidden; border-radius: var(--radius); background: #000; }
  .vid video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vid--hover { cursor: pointer; }
  .vid__badge { position: absolute; left: 12px; bottom: 12px; display: inline-flex; gap: 6px; align-items: center; padding: 6px 11px; border-radius: 999px; background: #000a; color: #fff; font-family: var(--font-mono); font-size: 11px; pointer-events: none; transition: opacity 0.3s; }
  .vid.is-playing .vid__badge { opacity: 0; }
</style>

<script>
  function init() {
    // Clips that play while on screen (muted, so autoplay is allowed)
    const auto = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (auto.length && 'IntersectionObserver' in window && !reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.5 },
      );
      auto.forEach((v) => io.observe(v));
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }

    // Gallery tiles: play on hover, toggle on click / tap
    document.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((v) => {
      const box = v.parentElement as HTMLElement;
      const sync = () => box.classList.toggle('is-playing', !v.paused);
      const play = () => v.play().then(sync).catch(() => {});
      const stop = () => { v.pause(); sync(); };
      if (matchMedia('(hover: hover)').matches && !reduce) {
        box.addEventListener('mouseenter', play);
        box.addEventListener('mouseleave', stop);
      }
      box.addEventListener('click', () => (v.paused ? play() : stop()));
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
