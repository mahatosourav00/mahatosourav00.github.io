---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
  ratio?: string; // CSS aspect-ratio, e.g. '4 / 3'
  sizes?: string;
  reveal?: boolean;
  class?: string;
  eager?: boolean;
  /** CSS object-position for the crop, e.g. 'center 30%' */
  position?: string;
}
const { src, alt, label, ratio = '4 / 3', sizes = '(max-width: 800px) 100vw, 50vw', reveal = true, class: cls, eager = false, position } = Astro.props;
// Deterministic glow position per label so placeholders don't all look identical
const seed = [...(label ?? alt)].reduce((a, c) => a + c.charCodeAt(0), 0);
const px = 20 + (seed * 37) % 60;
const py = 20 + (seed * 53) % 60;
---
<div class:list={['media', cls]} style={`aspect-ratio:${ratio}`} data-reveal-img={reveal ? '' : undefined}>
  {src ? (
    <Image src={src} alt={alt} sizes={sizes} widths={[480, 800, 1200, 1800]} loading={eager ? 'eager' : 'lazy'} class="media__img" style={position ? `object-position:${position}` : undefined} />
  ) : (
    <div class="ph media__img" style={`--px:${px}%;--py:${py}%`} role="img" aria-label={alt}>
      <span class="ph__label">{label ?? alt} · photo coming soon</span>
    </div>
  )}
</div>

<style>
  .media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--surface); }
  .media__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  :global(a:hover) .media__img, :global([data-hover]:hover) .media__img { transform: scale(1.04); }
</style>
