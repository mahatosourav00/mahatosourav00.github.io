---
import Article from '../../layouts/Article.astro';
import Media from '../../components/Media.astro';
import { getCollection, render } from 'astro:content';
import { getMaking } from '../../lib/making';

export async function getStaticPaths() {
  const items = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
  return items.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: items[(i + 1) % items.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Research that grew out of the hobby builds shows where it came from (src/content/making.json).
const steps = await getMaking();
const self = steps.find((st) => st.data.research?.id === entry.id);
const grewFrom = self ? self.data.from.map((f) => ({ step: steps.find((st) => st.id === f.id)!, via: f.via })) : [];
---
<Article
  title={d.title}
  description={d.summary}
  eyebrow={d.mission ? `Research · ${d.mission}` : 'Research'}
  back={{ href: '/research', label: 'All research' }}
  meta={[
    { k: 'Role', v: d.role },
    { k: 'Where', v: d.org },
    { k: 'When', v: d.period },
  ]}
  next={{ href: `/research/${next.id}`, title: next.data.short }}
  cover={d.cover}
>
  {/* No cover yet (results still unpublished): skip the hero so the page opens on the text, not an empty box */}
  {d.cover && <div slot="hero" class="wrap"><Media src={d.cover} alt={d.title} label={d.mission ?? d.short} ratio="21 / 9" eager sizes="100vw" /></div>}
  <Content />
  <div slot="aside" class="aside">
    <p class="mono muted">Keywords</p>
    <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
    {grewFrom.length > 0 && (
      <div class="lin">
        <p class="mono muted">Grew out of · <a href={`/hobbies#step-${self!.id}`} class="link">see the whole chain</a></p>
        <ul>
          {grewFrom.map((l) => (
            <li><a href={l.step.href ?? `/hobbies#step-${l.step.id}`}><span class="lin__t">{l.step.data.short} →</span><span class="muted lin__via">{l.via}</span></a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Article>

<style>
  .aside { position: sticky; top: 120px; }
  .lin { margin-top: 32px; }
  .lin ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .lin a { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; border-top: 1px solid var(--line); }
  .lin__t { font-size: 15px; transition: color 0.3s; }
  .lin a:hover .lin__t { color: var(--accent); }
  .lin__via { font-size: 13px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
</style>
