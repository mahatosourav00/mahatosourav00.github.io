---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Media from '../../components/Media.astro';
import { getCollection } from 'astro:content';

const allAlbums = await getCollection('albums');
const albums = allAlbums.filter((a) => !a.data.parent).sort((a, b) => a.data.order - b.data.order);
const frameCount = (a: (typeof allAlbums)[number]) => a.data.items.length + allAlbums.filter((c) => c.data.parent === a.id).reduce((n, c) => n + c.data.items.length, 0);
---
<Base title="Hobbies" description="Astrophotography, photography and 3D printing by Sourav Mahato.">
  <PageHeader
    eyebrow="Hobbies"
    title="What I do"
    italic="after hours."
    lead="Most of my hobbies end up feeding my research, and most of my research started as a hobby. Here's the overlap."
  />

  <section class="wrap doors">
    {albums.map((a, i) => {
      const subs = allAlbums.filter((c) => c.data.parent === a.id).sort((x, y) => x.data.order - y.data.order);
      return subs.length > 0 ? (
        <div class="door door--group" id={a.id}>
          <span class="mono muted door__i">0{i + 1}</span>
          <div class="door__text">
            <span class="mono accent">{a.data.kicker}</span>
            <h2 class="display-l door__title door__title--static">{a.data.title}</h2>
            <p class="muted door__intro">{a.data.intro}</p>
            <span class="mono muted">{subs.length} albums · {frameCount(a)} frames</span>
          </div>
          <div class="subs">
            {subs.map((c) => (
              <a href={`/hobbies/${a.id}/${c.id}`} class="sub" data-cursor="Open">
                <Media src={c.data.cover ?? c.data.items.find((x) => x.src)?.src} alt={c.data.title} label={c.data.title} ratio="4 / 5" />
                <div class="sub__meta">
                  <h3 class="display-s">{c.data.title}</h3>
                  <span class="mono muted">{c.data.items.length}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a href={`/hobbies/${a.id}`} class="door" data-cursor="Enter">
          <span class="mono muted door__i">0{i + 1}</span>
          <div class="door__text">
            <span class="mono accent">{a.data.kicker}</span>
            <h2 class="display-l door__title">{a.data.title}</h2>
            <p class="muted door__intro">{a.data.intro}</p>
            <span class="mono muted">{frameCount(a)} frames →</span>
          </div>
          <div class="door__media">
            <Media src={a.data.cover ?? a.data.items.find((x) => x.src)?.src} alt={a.data.title} label={a.data.title} ratio="4 / 3" />
          </div>
        </a>
      );
    })}
  </section>

  <section class="section wrap more">
    <p class="eyebrow" data-reveal>Also into</p>
    <ul class="also" data-reveal>
      <li>FPV flying</li><li>Home automation</li><li>Radio & RF</li><li>Electronics repair</li><li>Science outreach</li>
    </ul>
  </section>
</Base>

<style>
  .doors { display: grid; border-top: 1px solid var(--line); }
  .door { display: grid; grid-template-columns: 60px 1fr 1fr; gap: clamp(20px, 4vw, 60px); align-items: center; padding: clamp(40px, 6vw, 80px) 0; border-bottom: 1px solid var(--line); }
  .door__i { align-self: start; }
  .door--group { grid-template-columns: 60px 1fr; align-items: start; }
  .door--group .door__text { max-width: 60ch; }
  .door__title--static { transition: none; }
  .subs { grid-column: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.5vw, 32px); margin-top: clamp(8px, 2vw, 24px); }
  .sub__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 12px; }
  .sub:hover h3 { color: var(--accent); }
  .sub h3 { transition: color 0.3s; }
  .door__title { margin: 12px 0 20px; transition: color 0.4s, transform 0.6s var(--ease); }
  .door:hover .door__title { color: var(--accent); transform: translateX(12px); }
  .door__intro { max-width: 40ch; }
  .also { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 32px; font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 48px); }
  .also li:not(:last-child)::after { content: '·'; margin-left: 32px; color: var(--accent); }
  @media (max-width: 800px) { .door, .door--group { grid-template-columns: 1fr; } .door__i { display: none; } .subs { grid-column: 1; grid-template-columns: 1fr; } }
</style>
