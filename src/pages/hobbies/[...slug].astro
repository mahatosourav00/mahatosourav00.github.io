---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import 'photoswipe/style.css';

export async function getStaticPaths() {
  const all = await getCollection('albums');
  const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) => a.data.order - b.data.order;
  const pathOf = (e: (typeof all)[number]) => (e.data.parent ? `${e.data.parent}/${e.id}` : e.id);
  return all.map((entry) => {
    const sibs = all.filter((a) => a.data.parent === entry.data.parent).sort(byOrder);
    const next = sibs[(sibs.indexOf(entry) + 1) % sibs.length];
    const children = all.filter((a) => a.data.parent === entry.id).sort(byOrder).map((c) => ({ entry: c, path: pathOf(c) }));
    const parent = entry.data.parent ? all.find((a) => a.id === entry.data.parent) : undefined;
    return { params: { slug: pathOf(entry) }, props: { entry, next, nextPath: pathOf(next), children, parent } };
  });
}
const { entry, next, nextPath, children, parent } = Astro.props;
const isGroup = children.length > 0;
const frames = isGroup ? children.reduce((n, c) => n + c.entry.data.items.length, 0) : 0;
const d = entry.data;
const ratioCss = { portrait: '4 / 5', landscape: '3 / 2', square: '1 / 1' } as const;

const items = await Promise.all(
  d.items.map(async (it) => {
    const full = it.src ? await getImage({ src: it.src, width: Math.min(it.src.width, 2400) }) : null;
    return { ...it, full };
  }),
);
---
<Base title={d.title} description={d.intro}>
  <header class="wrap ahead">
    <a href={parent ? `/hobbies/${parent.id}` : '/hobbies'} class="mono muted link back" data-reveal data-immediate>← {parent ? parent.data.title : 'Hobbies'}</a>
    <p class="eyebrow" data-reveal data-immediate>{d.kicker}</p>
    <h1 class="display-xl" data-split data-immediate>{d.title}</h1>
    <div class="ahead__row">
      <p class="lead muted" data-reveal data-immediate data-delay="0.3">{d.intro}</p>
      {d.gear.length > 0 && (
        <div data-reveal data-immediate data-delay="0.4">
          <p class="mono muted">Gear</p>
          <ul class="gear">{d.gear.map((g) => <li>{g}</li>)}</ul>
        </div>
      )}
    </div>
  </header>

  {isGroup && (
    <section class="wrap subs">
      {children.map((c, i) => (
        <a href={`/hobbies/${c.path}`} class="sub" data-cursor="Open" data-reveal>
          <Media src={c.entry.data.cover ?? c.entry.data.items.find((x) => x.src)?.src} alt={c.entry.data.title} label={c.entry.data.title} ratio="4 / 5" />
          <div class="sub__meta">
            <span class="mono muted">0{i + 1} · {c.entry.data.items.length} frames</span>
            <h2 class="display-s">{c.entry.data.title}</h2>
            <p class="muted sub__intro">{c.entry.data.intro}</p>
          </div>
        </a>
      ))}
    </section>
  )}

  {!isGroup && (
  <section class="wrap masonry" data-pswp-gallery>
    {items.map((it, i) => {
      const inner = (
        <>
          <Media src={it.src} alt={it.title} label={it.title} ratio={it.src ? `${it.src.width} / ${it.src.height}` : ratioCss[it.ratio]} sizes="(max-width: 700px) 100vw, 33vw" />
          <figcaption class="cap">
            <span class="cap__t">{it.title}</span>
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
          </figcaption>
          {Object.keys(it.meta).length > 0 && (
            <dl class="exif">
              {Object.entries(it.meta).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}
        </>
      );
      return it.full ? (
        <figure class="tile" data-reveal>
          <a href={it.full.src} data-pswp-width={it.full.attributes.width} data-pswp-height={it.full.attributes.height} data-caption={it.caption ?? it.title} data-cursor="Zoom" target="_blank">{inner}</a>
        </figure>
      ) : (
        <figure class="tile" data-reveal data-hover>{inner}</figure>
      );
    })}
  </section>
  )}

  {next !== entry && (
    <a href={`/hobbies/${nextPath}`} class="wrap nextalb" data-cursor="Next">
      <span class="mono muted">Next album</span>
      <span class="display-l">{next.data.title} →</span>
    </a>
  )}
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  let lb: PhotoSwipeLightbox | null = null;
  function init() {
    if (!document.querySelector('[data-pswp-gallery] a[data-pswp-width]')) return;
    lb = new PhotoSwipeLightbox({
      gallery: '[data-pswp-gallery]',
      children: 'a[data-pswp-width]',
      bgOpacity: 0.96,
      pswpModule: () => import('photoswipe'),
    });
    lb.on('uiRegister', () => {
      lb!.pswp?.ui?.registerElement({
        name: 'caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          pswp.on('change', () => {
            const a = pswp.currSlide?.data.element as HTMLElement | undefined;
            el.textContent = a?.dataset.caption ?? '';
          });
        },
      });
    });
    lb.init();
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { lb?.destroy(); lb = null; });
</script>

<style>
  .ahead { padding-top: clamp(130px, 18vw, 220px); padding-bottom: clamp(48px, 7vw, 96px); }
  .back { display: inline-block; margin-bottom: 40px; text-transform: none; letter-spacing: 0; }
  .ahead__row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; margin-top: 36px; align-items: start; }
  .gear { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 4px; }
  @media (max-width: 800px) { .ahead__row { grid-template-columns: 1fr; } }

  .subs { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); padding-bottom: clamp(60px, 8vw, 110px); }
  .sub__meta { display: grid; gap: 8px; padding-top: 16px; }
  .sub__intro { font-size: 14px; margin: 0; max-width: 34ch; }
  .sub:hover h2 { color: var(--accent); }
  .sub h2 { transition: color 0.3s; }
  @media (max-width: 800px) { .subs { grid-template-columns: 1fr; } }

  .masonry { columns: 3 320px; column-gap: clamp(16px, 2vw, 28px); }
  .tile { break-inside: avoid; margin: 0 0 clamp(28px, 3vw, 44px); }
  .tile a { display: block; }
  .cap { display: flex; justify-content: space-between; gap: 12px; margin-top: 12px; }
  .cap__t { font-family: var(--font-display); font-size: 22px; line-height: 1.15; }
  .exif { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 8px 0 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .exif div { display: flex; gap: 6px; }
  .exif dt { color: var(--faint); }
  .exif dd { margin: 0; }

  .nextalb { display: flex; flex-direction: column; gap: 12px; padding-block: clamp(80px, 10vw, 140px); border-top: 1px solid var(--line); transition: color 0.3s; }
  .nextalb:hover { color: var(--accent); }

  :global(.pswp__caption) { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 12px; color: #ecebe6; background: #0009; padding: 8px 14px; border-radius: 999px; }
</style>
